# Environment
.env
.venv/
__pycache__/
*.pyc

# OS
.DS_Store

# Data — generated/regenerable, not committed
data/audio/*
data/synthetic/*
data/asr_transcripts/*
!data/audio/.gitkeep
!data/synthetic/.gitkeep

# The audio manifest IS tracked: ~700 KB of metadata, and it is the phase 3
# ground truth — it maps each audio file to its reference transcript and to the
# true speaker of every segment, which is what WER and the diarization check are
# scored against. The WAVs it points at are ~640 MB and stay out.
!data/audio/manifest.json

# Result records are tracked too — small JSON, and they are the per-call detail
# behind the tables in eval_results.md. The ASR transcripts themselves are
# regenerable and stay out.
!data/asr_transcripts/wer_report.json
!data/asr_transcripts/wer_report_forced_ar_superseded.json
!data/asr_transcripts/en_reextract_metrics.json
!data/asr_transcripts/en_reextract_predictions.json

# data/ground_truth/*.json is hand-labeled human work — irreplaceable,
# tracked in git (unlike audio/synthetic, it cannot be regenerated).

# The 15 ar transcripts scripts/eval_held_out_calls.py needs are tracked
# explicitly, the same allow-list idiom as data/asr_transcripts above.
# "Regenerable" is true of data/synthetic/* in general (a generation script
# exists) but not exactly reproducible — re-running it would not recreate
# this specific text, and data/ground_truth/*.json's quotes are matched
# against exactly this text. A Colab clone (git clone, not a copy of this
# machine's working tree) needs these files physically present, not
# regenerated. See docs/09-DECISIONS.md, 2026-09-27. Update this list if
# held_out_call_ids.json ever gains en/mixed entries.
!data/synthetic/call_0014_ar.txt
!data/synthetic/call_0017_ar.txt
!data/synthetic/call_0031_ar.txt
!data/synthetic/call_0048_ar.txt
!data/synthetic/call_0053_ar.txt
!data/synthetic/call_0057_ar.txt
!data/synthetic/call_0069_ar.txt
!data/synthetic/call_0075_ar.txt
!data/synthetic/call_0088_ar.txt
!data/synthetic/call_0094_ar.txt
!data/synthetic/call_0100_ar.txt
!data/synthetic/call_0112_ar.txt
!data/synthetic/call_0118_ar.txt
!data/synthetic/call_0122_ar.txt
!data/synthetic/call_0129_ar.txt

# Phase 4 five-batch experiment resume state — transient, deleted by a
# successful run, and meaningless outside the machine/DB it was written on.
data/five_batch_checkpoint.json

# Phase 5 dataset-build memoization cache (scripts/build_finetune_dataset.py)
# — raw agent outputs keyed by call_id, regenerable, exists only to avoid
# re-spending LLM quota on a re-run. Not a result; train/val.jsonl and
# MANIFEST.json are.
data/finetune/_diff_cache/

# Phase 5 trained LoRA adapter (scripts/train_qlora.py) — ~900 MB including
# checkpoint-*/ subdirectories, backed up to Google Drive instead (see
# notebooks/qlora_train.ipynb). A build artifact, not a result record — the
# same distinction as _diff_cache/ above; train_log.csv, forgetting_eval.json
# and held_out_eval.json (the actual measurements) are tracked normally.
data/finetune/qlora_adapter/

# Database backups (pg_dump). They contain call transcripts — the pre-0001
# dev DB backup holds them *unredacted* — so they never go in git.
data/backups/

# Test / build artifacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
uv.lock.bak
.claude/
