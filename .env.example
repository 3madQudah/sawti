# Copy to .env and fill in secrets. See src/sawti/config.py for the full list
# of settings and their defaults.

# --- App ---
SAWTI_ENV=development
SAWTI_LOG_LEVEL=INFO

# --- LLM provider ---
# anthropic | vllm | gemini | fake. `fake` is deterministic and offline, for
# the service e2e (`make e2e`) and load measurement — never for real analysis.
SAWTI_LLM_PROVIDER=gemini
SAWTI_LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=
GEMINI_API_KEY=
SAWTI_GEMINI_MODEL=gemini-flash-lite-latest

# --- Confidence / review routing ---
SAWTI_CONFIDENCE_THRESHOLD=0.7

# --- Postgres ---
# For code running on the host. The compose services override this with the
# in-network host (`postgres:5432`); see docker-compose.yml.
DATABASE_URL=postgresql+psycopg://sawti:sawti@localhost:5432/sawti
# Host port for the postgres container (5433 if a local Postgres owns 5432).
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Service (phase 6.2) ---
# Shared key for every API route except /health. Generate one, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Empty or unset = the API refuses protected routes (fails closed).
# NOT authentication: it will be visible in the 6.4 dashboard's browser
# bundle. See docs/09-DECISIONS.md, 2026-10-06, decision 3.
SAWTI_API_KEY=
SAWTI_API_HOST=127.0.0.1
SAWTI_API_PORT=8000
# Browser origins allowed by CORS, as a JSON list, e.g. ["http://localhost:5173"]
SAWTI_CORS_ORIGINS=[]
# Celery retries on transient provider errors (429 / quota / 5xx / timeout):
# delay = BACKOFF * 2**attempt, capped at BACKOFF_MAX; then the call is `failed`.
SAWTI_TASK_MAX_RETRIES=5
SAWTI_TASK_RETRY_BACKOFF_SECONDS=10
SAWTI_TASK_RETRY_BACKOFF_MAX_SECONDS=300
# Memory rules folded into the extraction prompt (top-k).
SAWTI_MEMORY_TOP_K=5
# Load the embedding model when each worker process starts (cold start).
SAWTI_WORKER_PRELOAD_EMBEDDINGS=true
# `fake` provider only: simulated latency, and unsupported claims per call
# (1 => every call escalates at the default 0.7 threshold).
SAWTI_FAKE_LLM_LATENCY_SECONDS=0
SAWTI_FAKE_LLM_UNGROUNDED_CLAIMS=1
# Which database the compose stack uses (default: POSTGRES_DB's `sawti`).
# scripts/measure_service.py sets its own scratch database.
SAWTI_SERVICE_DB=sawti

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- ASR ---
# large-v3-turbo is the default for practical throughput on Apple Silicon;
# set large-v3 on hardware that can carry it. See docs/09-DECISIONS.md.
WHISPER_MODEL=large-v3-turbo
# Fallback forced language, used for any category without an override below.
WHISPER_LANGUAGE=ar
# Per-language-category forced language, as JSON. Overrides WHISPER_LANGUAGE.
# Default: English calls decode as English; ar and mixed stay on the Arabic
# decoder. Setting this replaces the whole mapping, so include every override
# you want. See docs/09-DECISIONS.md.
WHISPER_LANGUAGE_OVERRIDES={"en": "en"}
# HuggingFace read token, required for pyannote's gated diarization pipelines.
# Accept the licences at pyannote/segmentation-3.0 and
# pyannote/speaker-diarization-3.1, then create a token at
# https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# --- Fine-tuning (Phase 5) ---
# Confirmed explicitly with the user, 2026-09-25 (not guessed — see
# docs/09-DECISIONS.md): the instruction/chat-tuned Qwen3-8B, not -Base.
# Only read by scripts/train_qlora.py on a CUDA host (Colab).
SAWTI_FINETUNE_BASE_MODEL=Qwen/Qwen3-8B
